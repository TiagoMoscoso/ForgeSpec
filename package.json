{
  "name": "@tiagomoscoso/forgespec",
  "version": "0.1.0",
  "description": "Customizable harness for AI software engineering: architectural intent, executable task graphs, and evidence-gated delivery.",
  "keywords": [
    "forgespec",
    "cli",
    "ai",
    "spec",
    "harness",
    "sdd"
  ],
  "homepage": "https://github.com/TiagoMoscoso/ForgeSpec",
  "bugs": {
    "url": "https://github.com/TiagoMoscoso/ForgeSpec/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TiagoMoscoso/ForgeSpec.git"
  },
  "license": "MIT",
  "author": "ForgeSpec Contributors",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "forgespec": "./bin/forgespec.js"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "LICENSE",
    "README.md",
    "!dist/**/*.test.js",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src/ test/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:skills": "pnpm run build && node scripts/generate-skills.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
