{
  "title": "ForgeSpec delivery",
  "uid": "forgespec-delivery",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Tool runs",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(forgespec_tool_runs_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool duration",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(forgespec_tool_duration_seconds_bucket[5m])) by (le, tool))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Validator failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(forgespec_validator_failures_total[5m])) by (validator)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Stale evidence",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(forgespec_evidence_stale_total)",
          "refId": "A"
        }
      ]
    }
  ]
}
